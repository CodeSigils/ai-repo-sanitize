#!/bin/sh
# Pre-commit gate for ai-repo-sanitize. POSIX sh only, no bashisms.
# Install with: git config core.hooksPath .githooks
set -e

echo "=== pre-commit: ruff ==="
uv run ruff check .

echo "=== pre-commit: type check ==="
uv run ty check

echo "=== pre-commit: docs contract ==="
uv run python scripts/validate-docs.py

echo "=== pre-commit: doc claims ==="
uv run python scripts/check-doc-claims.py

# CI shellchecks the hooks on ubuntu runners; mirror it locally when the tool
# is present. Guarded so the hook never adds a hard tool dependency (SECURITY.md
# limits required binaries to git and gh).
echo "=== pre-commit: shellcheck hooks ==="
if command -v shellcheck >/dev/null 2>&1; then
  shellcheck .githooks/pre-commit .githooks/commit-msg
else
  echo "shellcheck not installed; skipping (CI still enforces it)" >&2
fi

echo "=== pre-commit: PASS ==="